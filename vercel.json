{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.github.com; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/cbapp/en", "destination": "/site/en.html" },
    { "source": "/cbapp/de", "destination": "/site/de.html" },
    { "source": "/cbapp/feedback", "destination": "/site/feedback.html" },
    { "source": "/cbapp/feedback.html", "destination": "/site/feedback.html" },
    { "source": "/cbapp/changelog", "destination": "/site/changelog.html" },
    { "source": "/cbapp/changelog.html", "destination": "/site/changelog.html" },
    { "source": "/cbapp/download", "destination": "/site/download.html" },
    { "source": "/cbapp/download.html", "destination": "/site/download.html" },
    { "source": "/cbapp/success.html", "destination": "/site/success.html" },
    { "source": "/cbapp/:file", "destination": "/site/:file" },
    { "source": "/cbapp", "destination": "/site/index.html" },
    { "source": "/cbapp/", "destination": "/site/index.html" },
    { "source": "/", "destination": "/site/home.html" },
    { "source": "/index.html", "destination": "/site/home.html" }
  ]
}
